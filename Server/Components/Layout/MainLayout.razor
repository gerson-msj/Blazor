@inherits LayoutComponentBase
@inject MsgboxService msgboxService

@implements IDisposable

<div class="page">
    <header>
        <h1>Biblioteca</h1>
    </header>
    <main>
        @Body
        <hr />
        <h1>
            Title: @msgboxService.Request?.MsgText
        </h1>
        <button @onclick="HandleClick">Fechar</button>
    </main>
</div>

