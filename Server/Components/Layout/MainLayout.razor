@code {
    protected override void OnInitialized()
    {
        msgboxService.Changed += OnChanged;
    }

    private void OnChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        msgboxService.Changed -= OnChanged;
    }

    private void HandleClick(MouseEventArgs args)
    {
        msgboxService.Close();
    }
}