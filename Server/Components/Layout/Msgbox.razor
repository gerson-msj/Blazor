@using Markdig
@implements IDisposable

<Popup @ref="popup" OnClose="HandleClose">
    <div class="card">
        @if (!string.IsNullOrEmpty(request.Title))
        {
            <div class="card-header">
                @request.Title
            </div>
        }

        <div class="card-body">
            <div class="card-text">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    @markdownText
                }
            </div>
        </div>

        @if (hasButton)
        {
            <div class="card-footer btn-group">
                @if (hasOk)
                {
                    <button type="button" class="btn btn-outline-primary"
                            @onclick="() => Close(Response.Ok)">@request.Ok</button>
                }
                @if (hasCancel)
                {
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="() => Close(Response.Cancel)">@request.Cancel</button>
                }
            </div>
        }
    </div>
</Popup>

@code {
    public class Request
    {
        public string? Title { get; set; }
        public string? Text { get; set; }
        public string? Ok { get; set; }
        public string? Cancel { get; set; }
        public int Width { get; set; } = 400;
    }

    public enum Response
    {
        Ok,
        Cancel,
        None
    }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    private Popup popup = null!;
    private Request request = new();
    private MarkupString markdownText => new(Markdown.ToHtml(request.Text ?? string.Empty));
    private bool hasOk => !string.IsNullOrEmpty(request.Ok);
    private bool hasCancel => !string.IsNullOrEmpty(request.Cancel);
    private bool hasButton => hasOk || hasCancel;
    private TaskCompletionSource<Response>? tcs;

    public Task<Response> Open(Request request)
    {
        this.request = request;
        popup.Open(new()
        {
            Width = request.Width,
            DisableBackdrop = hasButton
        });

        tcs = new(TaskCreationOptions.RunContinuationsAsynchronously);
        return tcs.Task;
    }

    private void Close(Response response)
    {
        popup.Close();
        tcs?.TrySetResult(response);
        tcs = null;
    }

    public void Dispose()
    {
        Close(Response.None);
        tcs = null;
    }
    private void HandleClose(bool args)
    {
        if (args)
        {
            tcs?.TrySetResult(Response.Cancel);
            tcs = null;
        }
    }
}