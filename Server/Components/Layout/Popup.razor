@using Blazor.Server.Models
@using Microsoft.AspNetCore.Server.HttpSys
@using Microsoft.AspNetCore.SignalR.Protocol
@inject PopupService service
@implements IDisposable

<div class="backdrop" @onclick="HandleBackdropClick" style="@backdropStyle">
    <div class="box" style="@boxStyle" @onclick:stopPropagation="true">
        @ChildContent
    </div>
</div>

@code {

    [Parameter] public string PopupName { get; set; } = "default";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private PopupRequestModel request = new();
    private bool isOpen;

    private string backdropStyle =>
        $"{(request.DisableBackdrop ? "" : "cursor: pointer;")} {(isOpen
                ? "opacity: 1; visibility: visible; pointer-events: auto;"
                : "opacity: 0; visibility: hidden; pointer-events: none;")}";
    private string boxStyle =>
        $"width: {request.Width}px; {(isOpen
            ? "opacity: 1; transform: translateY(0) scale(1);"
            : "opacity: 0; transform: translateY(6px) scale(0.98);")}";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        service.OnOpen += HandleOpen;
        service.OnClose += HandleClose;
    }

    private void HandleOpen(PopupRequestModel request)
    {
        if (request.PopupName == PopupName)
        {
            this.request.Width = request.Width;
            this.request.DisableBackdrop = request.DisableBackdrop;
            isOpen = true;
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleClose(string popupName)
    {
        if (popupName == PopupName)
        {
            isOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleBackdropClick()
    {
        if (!request.DisableBackdrop && isOpen)
        {
            service.Close(isBackdropClick: true, popupName: PopupName);
        }
    }

    public void Dispose()
    {
        service.OnOpen -= HandleOpen;
        service.OnClose -= HandleClose;
    }
}