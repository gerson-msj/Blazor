@using System.IO.IsolatedStorage

<div class="backdrop" @onclick="CloseByBackdrop" style="@backdropStyle">
    <div class="box" style="@boxStyle" @onclick:stopPropagation="true">
        @ChildContent
    </div>
</div>

@code {
    public class Request
    {
        public int Width { get; set; } = 400;
        public bool DisableBackdrop { get; set; }
    }

    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    private Request request = new();
    private bool isOpen;

    private string backdropStyle =>
            $"{(request.DisableBackdrop ? "" : "cursor: pointer;")} {(isOpen
                    ? "opacity: 1; visibility: visible; pointer-events: auto;"
                    : "opacity: 0; visibility: hidden; pointer-events: none;")}";
    private string boxStyle =>
        $"width: {request.Width}px; {(isOpen
            ? "opacity: 1; transform: translateY(0) scale(1);"
            : "opacity: 0; transform: translateY(6px) scale(0.98);")}";

    public void Open() => Open(new());
    public void Open(Request model)
    {
        this.request = model;
        isOpen = true;
        InvokeAsync(StateHasChanged);
    }

    public void Close() => Close(false);

    private async Task CloseByBackdrop()
    {
        if (!request!.DisableBackdrop)
        {
            Close(true);
        }
    }

    private void Close(bool byBackdrop)
    {
        if (isOpen)
        {
            isOpen = false;
            InvokeAsync(StateHasChanged);
            if (OnClose.HasDelegate)
                OnClose.InvokeAsync(byBackdrop);
        }

    }
}