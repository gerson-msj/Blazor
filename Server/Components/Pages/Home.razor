@page "/"
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<button type="button" class="btn btn-info" @onclick='() => Nav.NavigateTo("/livros")'>Livros</button>
<button type="button" class="btn btn-info" @onclick='() => Nav.NavigateTo("/series")'>Séries</button>

<hr />

<Msgbox @ref="msgbox" />

<Popup @ref="popup">
    <p>Popup</p>
</Popup>

<button type="button" @onclick="HandleMsgbox">@labelMsgbox</button>
<button type="button" @onclick="HandlePopup">@labelPopup</button>

@code {

    private string labelMsgbox = "Abrir Msgbox";
    private string labelPopup = "Abrir Popup";
    private Msgbox msgbox = null!;
    private Popup popup = null!;


    private async Task HandleMsgbox()
    {
        var response = await msgbox.Open(new()
        {
            Title = "Mensagem",
            Text = "Conteúdo *formatado*",
            Ok = "Ok",
            Cancel = "Cancel"
        });

        labelMsgbox = $"Msgbox Result: {response}";
    }

    private void HandlePopup()
    {
        popup.Open();
    }
}