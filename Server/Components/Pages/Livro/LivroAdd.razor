@page "/livros/add"
@inject ILogger<LivroAdd> logger
@inject LivroService service
@inject AutorService autorService
@inject NavigationManager nav
@inject MsgboxService msgbox

@rendermode InteractiveServer

@using Blazor.Core.Domain.Dto
@using Blazor.Core.Service
@using Blazor.Server.Components.Shared
@using Blazor.Server.Models

<PageTitle>Novo Livro</PageTitle>

<h2>Novo Livro</h2>
<hr />

<EditForm FormName="livro_add" Model="model" OnValidSubmit="HandleSubmit">
    <AntiforgeryToken />
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label"> Autor: </label>
        <SelectComponent @bind-Value="model!.Autor" Itens="autores" />
    </div>

    <div class="mb-3">
        <label class="form-label"> Título: </label>
        <InputText @bind-Value="model!.Titulo" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label"> Data de conclusão: </label>
        <InputDate @bind-Value="model.DataConclusao" class="form-control" Type="InputDateType.Month" />
    </div>

    <div class="mb-3">
        <label class="form-label"> Comentários: </label>
        <InputTextArea @bind-Value="model.Comentarios" class="form-control" />
    </div>

    <div class="btn-group">
        <button type="submit" class="btn btn-primary">Adicionar</button>
        <button type="button" class="btn btn-secondary" @onclick="GoBack">Voltar</button>
    </div>


    <ValidationSummary />
</EditForm>

<Msgbox />

@code {

    [SupplyParameterFromForm]
    private LivroModel? model { get; set; }
    private List<SelectItemModel> autores = [];

    protected override async Task OnInitializedAsync()
    {
        model ??= new();
        await base.OnInitializedAsync();
        if (!RendererInfo.IsInteractive)
            await ObterAutores();
    }

    private async Task HandleSubmit(EditContext args)
    {
        LivroDto livro = model!.ToDto();
        try
        {
            await service.Create(livro.ToNewEntity());
            await msgbox.Open(new() { Text = "Gravação realizada com sucesso.", Ok = "Ok" });
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Falha da gravação do livro");
            await msgbox.Open(new() { Text = "Gravação não realizada!", Ok = "Ok" });
        }

        model = new();
        GoBack();
    }

    private async Task ObterAutores()
    {
        var entities = await autorService.ToListAsync();
        var dtos = entities.Select(e => new AutorDto(e));
        autores.AddRange(dtos.Select(d => new SelectItemModel(d.Id, d.Nome)));
    }
    private void GoBack()
    {
        nav.NavigateTo("/livros");
    }
}