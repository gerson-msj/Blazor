@page "/livros/add"
@inject ILogger<LivroAdd> logger
@inject LivroService service
@inject NavigationManager nav

@rendermode InteractiveServer

@using Blazor.Core.Domain.Dto
@using Blazor.Core.Service
@using Blazor.Server.Components.Shared
@using Blazor.Server.Models

<PageTitle>Novo Livro</PageTitle>

<h2>Novo Livro</h2>
<hr />

<LivroFormComponent @bind-Livro="livro" @bind-Livro:after="HandleSubmit" GoBack="HandleGoBack" />
<Msgbox @ref="msgbox" />

@code {

    private LivroModel livro { get; set; } = null!;
    private Msgbox msgbox = null!;

    protected override void OnInitialized()
    {
        livro ??= new();
        base.OnInitialized();
    }

    private async Task HandleSubmit()
    {
        LivroDto dto = livro!.ToDto();
        try
        {
            await service.Create(dto.ToNewEntity());
            await msgbox.Open(new() { Text = "Gravação realizada com sucesso.", Ok = "Ok" });
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Falha da gravação do livro");
            await msgbox.Open(new() { Text = "Gravação não realizada!", Ok = "Ok" });
        }

        livro = new();
        HandleGoBack();
    }

    private void HandleGoBack()
    {
        nav.NavigateTo("/livros");
    }
}