@page "/livros/edit/{id:int}"
@inject LivroService service
@inject NavigationManager nav
@inject ILogger<LivroEdit> log

@rendermode InteractiveServer

@using Blazor.Core.Domain.Dto
@using Blazor.Core.Domain.Entity
@using Blazor.Core.Service
@using Blazor.Server.Components.Shared
@using Blazor.Server.Models

<PageTitle>Editar Livro</PageTitle>

<h2>Editar Livro</h2>

@if (model is null)
{
    <p>Aguarde...</p>
}
else
{
    <LivroFormComponent @bind-Livro="model" @bind-Livro:after="HandleSave" GoBack="HandleGoBack" />
}

<Msgbox @ref="msgbox" />

@code {
    [Parameter] public int Id { get; set; }

    private LivroModel? model;
    private bool livroNaoLocalizado;
    private Msgbox msgbox = null!;

    protected override async Task OnParametersSetAsync()
    {
        model = await ObterLivro();
        livroNaoLocalizado = model is null;
        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (livroNaoLocalizado)
        {
            livroNaoLocalizado = false;
            await msgbox.Open(new() { Text = "Livro não localizado!", Ok = "Voltar" });
            HandleGoBack();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void HandleGoBack()
    {
        nav.NavigateTo("/livros");
    }

    public async Task<LivroModel?> ObterLivro()
    {
        var entity = await service.FindAsync(Id);
        if (entity is null)
            return null;

        LivroDto dto = new(entity);
        return new(dto);
    }
    private async Task HandleSave()
    {
        try
        {
            LivroDto dto = model!.ToDto();
            LivroEntity entity = dto.ToNewEntity();
            entity.Id = dto.Id;
            var saved = await service.Update(entity);
            if (saved)
            {
                await msgbox.Open(new() { Text = "Livro atualizado com sucesso.", Ok = "Ok" });
                HandleGoBack();
            }
            else
            {
                await msgbox.Open(new() { Text = "Livro inexistente!", Ok = "Ok" });
            }
        }
        catch (Exception ex)
        {
            log.LogError(ex, "Falha ao atualizar um livro");
            await msgbox.Open(new() { Text = "Atualização não realizada!", Ok = "Ok" });
        }
    }
}