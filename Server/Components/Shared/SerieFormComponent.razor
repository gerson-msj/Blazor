@using Blazor.Server.Models
@using Microsoft.AspNetCore.Components.Forms

<EditForm FormName="serie_form" Model="Model" OnValidSubmit="HandleSubmit">
    <AntiforgeryToken />
    <SerieFormValidator />

    <div class="mb-3">
        <label class="form-label">Série:</label>
        <SelectComponent @bind-Value="Model.Serie" Itens="series" />
    </div>

    <div class="mb-3">
        <label class="form-label">Autor:</label>
        <SelectComponent @bind-Value="Model.Autor" Itens="autores" />
    </div>

    <table class="table table-sm">
        <thead>
            <tr>
                <th scope="col">Livro</th>
                <th scope="col">Ordem</th>
                <th scope="col">Data de Conclusão</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var livro in Model.Livros)
            {
                <tr @key="livro.Key">
                    <td>
                        <InputText @bind-Value="livro.Titulo" class="form-control" />
                    </td>
                    <td>
                        <InputNumber @bind-Value="livro.Ordem" class="form-control" />
                    </td>
                    <td>
                        <InputDate Type="InputDateType.Month" @bind-Value="livro.DataConclusao" class="form-control" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-outline-danger"
                                @onclick="() => RemoverLivro(livro.Key)">Remover</button>
                    </td>
                </tr>
            }
            <tr>
                <td colspan="4">
                    <button type="button" class="btn btn-outline-secondary" @onclick="AdicionarLivro">Adicionar
                        Livro</button>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="btn-group">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <button type="button" class="btn btn-secondary" @onclick="GoBack">Voltar</button>
        </div>

        <ValidationSummary />
    </EditForm>

<Msgbox @ref="msgbox" />

@code {
    [Parameter, EditorRequired] public SerieModel Model { get; set; } = default!;
    [Parameter] public EventCallback<SerieModel> ModelChanged { get; set; }
    [Parameter] public EventCallback GoBack { get; set; }
    private List<SelectItemModel> autores = [];
    private List<SelectItemModel> series = [];
    private BaseLivroModel livroModel = new();
    private Msgbox msgbox = null!;

    @* private EditContext editContext = default!; *@

    @* protected override void OnParametersSet()
    {
        if (editContext is not null && ReferenceEquals(editContext.Model, Model))
            return;

        editContext = new(Model);
        editContext.SetFieldCssClassProvider(new SerieFieldCssClassProvider());
    } *@

    private Task HandleSubmit()
    {
        return ModelChanged.InvokeAsync(Model);
    }

    private void AdicionarLivro()
    {
        int ordem = Model.Livros
            .Where(l => !l.Excluido)
            .Select(l => l.Ordem ?? 0)
            .DefaultIfEmpty(0)
            .Max();

        Model.Livros.Add(new()
        {
            Ordem = ordem + 1
        });
    }

    private async Task RemoverLivro(Guid key)
    {

        var msgboxResult = await msgbox.Open(new()
        {
            Title = "Remover",
            Text = "Deseja realmente *remover* este livro?",
            Ok = "Sim",
            Cancel = "Não"
        });

        if (msgboxResult == Msgbox.Response.Cancel)
            return;

        var livro = Model.Livros.Single(l => l.Key == key);
        var ordem = livro.Ordem ?? 0;
        livro.Excluido = true;

        foreach (var l in Model.Livros)
            if (!l.Excluido && l.Ordem.HasValue && l.Ordem > ordem)
                l.Ordem--;

        if (livro.Id == 0)
        {
            Model.Livros.Remove(livro);
        }
    }

    private sealed class SerieFieldCssClassProvider : FieldCssClassProvider
    {
        public override string GetFieldCssClass(EditContext editContext, in FieldIdentifier fieldIdentifier)
        {
            if (fieldIdentifier.Model is BaseLivroModel)
                return string.Empty;

            var isValid = !editContext.GetValidationMessages(fieldIdentifier).Any();
            if (editContext.IsModified(fieldIdentifier))
                return isValid ? "modified valid" : "modified invalid";

            return isValid ? "valid" : "invalid";
        }
    }

}